<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ex2.PrimaryController">
    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>
    
    <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Local Chat Room" />
    
    <TextArea fx:id="txtChatHistory" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
    
    <HBox spacing="10">
        <TextField fx:id="txtInput" onAction="#handleSendMessage" promptText="Nhập tin nhắn..." text="ggg" HBox.hgrow="ALWAYS" />
        <Button fx:id="btnSend" onAction="#handleSendMessage" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Gửi" />
    </HBox>
</VBox>
